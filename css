:root{
  --caramel-900:#3a2210;--caramel-700:#6e431f;--caramel-600:#7e4f27;--caramel-500:#a9682f;--caramel-400:#ce9657;--caramel-300:#e0b57f;
  --cream-50:#fffdf8;--cream-100:#fff8ee;--cream-200:#f6e7d2;--cream-300:#ead6bb;
  --ink-900:#241505;--ink-700:#3d2612;--ink-500:#6b4c2e;
  --ivory:#fff7ec;--rust:#b34a2e;--heart:#c0554d;
  --r-pill:999px;
  --font-head:'Cormorant Garamond',Georgia,serif;
  --font-text:'Manrope',-apple-system,system-ui,sans-serif;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%}
body{font-family:var(--font-text);color:var(--ink-900);background:var(--caramel-700)}
.sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.skip-link{position:absolute;left:-999px;top:0;z-index:99;background:var(--ivory);color:var(--ink-900);padding:12px 16px;border-radius:0 0 12px 0}
.skip-link:focus{left:0}
.hidden{display:none !important}
#scene{position:fixed;inset:0;height:100dvh;overflow:hidden;display:flex;flex-direction:column;
  background:radial-gradient(120% 90% at 50% 0%,var(--caramel-500) 0%,var(--caramel-700) 55%,var(--caramel-900) 100%)}
#stage{position:relative;flex:1;overflow:hidden}
#meter{position:absolute;top:0;left:0;right:0;height:4px;background:rgba(255,247,236,.18);z-index:30}
#meter-fill{height:100%;width:0;background:var(--cream-100);transition:width .25s ease}
.topbar{position:absolute;top:max(12px,env(safe-area-inset-top));right:12px;display:flex;gap:8px;z-index:40}
.topbar--left{right:auto;left:12px}
.icon-btn{min-width:44px;min-height:44px;border:0;border-radius:var(--r-pill);background:rgba(58,34,16,.55);color:var(--cream-100);font-size:20px;line-height:1;cursor:pointer}
.icon-btn:focus-visible,.pill-btn:focus-visible{outline:3px solid var(--cream-100);outline-offset:2px}
.pill{position:absolute;left:50%;transform:translateX(-50%);bottom:calc(16px + env(safe-area-inset-bottom));background:var(--ivory);color:var(--ink-700);border-radius:var(--r-pill);padding:12px 20px;font-size:15px;font-weight:600;box-shadow:0 6px 18px rgba(36,21,5,.35);z-index:40;max-width:min(92vw,560px);text-align:center}
#hint{pointer-events:none}
.pill-btn{border:0;cursor:pointer;min-height:44px}
.controls{position:absolute;bottom:calc(16px + env(safe-area-inset-bottom));left:0;right:0;display:flex;justify-content:center;gap:10px;z-index:41}
.controls .pill{position:static;transform:none;bottom:auto}
.overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;background:var(--caramel-900);color:var(--cream-100);z-index:60;padding:24px;text-align:center}
#state-error{background:var(--rust)}
.card{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:56px 22px 96px;z-index:10}
.card__over{font-size:13px;letter-spacing:.18em;text-transform:uppercase;color:var(--cream-200);opacity:.85;margin:0 0 10px}
.card__title{font-family:var(--font-head);font-weight:700;font-size:clamp(30px,7vw,44px);line-height:1.1;margin:0 0 18px;color:var(--cream-50);text-align:center}
.card__body{width:min(92vw,520px);min-height:120px;display:flex;flex-direction:column;gap:10px;align-items:center;text-align:center;outline:none}
.line{margin:0;font-size:clamp(16px,4.4vw,19px);line-height:1.55;color:var(--cream-100);opacity:0;transform:translateY(8px);transition:opacity .5s ease,transform .5s ease}
.line.is-visible{opacity:1;transform:none}
.line.is-emphasised{font-weight:700;color:var(--ivory);font-size:clamp(17px,4.8vw,21px)}
.title-ghost{position:fixed;z-index:35;margin:0;pointer-events:none;color:var(--cream-50);font-family:var(--font-head);font-weight:700;text-align:center}
.finale-heart{font-size:min(40vw,180px);animation:beat 1.6s ease-in-out infinite}
.finale-text{font-family:var(--font-head);font-size:clamp(22px,6vw,32px);margin:0}
@keyframes beat{0%,100%{transform:scale(1)}12%{transform:scale(1.12)}24%{transform:scale(1)}36%{transform:scale(1.08)}}
@media (prefers-reduced-motion:reduce){
  *{animation:none !important;transition:none !important}
  .line{opacity:1;transform:none}
}
@media (prefers-reduced-transparency:reduce){
  #scene{background:var(--caramel-700)}
  .icon-btn{background:var(--caramel-900)}
}
